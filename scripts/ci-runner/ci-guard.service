[Unit]
Description=CI runner network guard (the runner user reaches the internet only)
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ci-guard.nft

[Install]
WantedBy=sysinit.target
# The runner does not start without the guard.
RequiredBy=sorento-runner.service
