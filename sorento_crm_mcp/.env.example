# Copy to .env (read from the directory python -m sorento_crm_mcp runs in).
CRM_BASE_URL=http://localhost:8000
EXTERNAL_API_KEY=<same as the backend's EXTERNAL_API_KEY>
# No MCP_AUTH_TOKEN / MCP_AUTH_MODE: the bearer token and its Enforce switch are set on the CRM's
# Settings > Integrations screen and fetched from the backend (MCP-TOKEN-UI).
