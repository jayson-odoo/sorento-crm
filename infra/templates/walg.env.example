# WAL-G to Cloudflare R2 (S3 API). Names only: values live in the box's env file, never in git.
# One bucket, one prefix per cluster; the standby uses the SAME prefix (it continues the archive
# on a new timeline after promotion).
WALG_S3_PREFIX=s3://<R2_BUCKET>/sorento-crm-pg17
AWS_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WALG_COMPRESSION_METHOD=brotli
# Client-side encryption (recommended): libsodium key, kept off the bucket.
WALG_LIBSODIUM_KEY=
# Nightly on the primary:  wal-g backup-push "$PGDATA"  && wal-g delete retain FULL 7 --confirm
