# The ONE place the three voters are named (HA-TIER1-N8N-BOX). Copied to /etc/sorento-ha/ on all
# three members; patroni.env and etcd.env are loaded alongside it (compose env_file), and
# templates/host/ha-members.nft mirrors the three addresses for the firewall.
# Moving the witness (shared-service box today, Hetzner EU later) = edit this file + the nft
# defines, following documentation/runbooks/ha-failover.md "Move the witness". No redesign.
KL_WG_IP=<KL_WG_IP>
IN_WG_IP=<IN_WG_IP>
# shared-service box today; e.g. witness-hz after the move
WITNESS_NAME=witness-ss
WITNESS_WG_IP=<WITNESS_WG_IP>

# Patroni reads its etcd endpoints from the env (overrides patroni.yml). It only needs one
# reachable member to discover the rest from etcd itself.
PATRONI_ETCD3_HOSTS=<KL_WG_IP>:2379,<IN_WG_IP>:2379,<WITNESS_WG_IP>:2379
