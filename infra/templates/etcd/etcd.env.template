# etcd member env, one per member (kl, in, witness). Plan section 2: three voters, three locations.
# Run the official etcd image (pin the version) with these as env; data dir on a volume.
ETCD_NAME=<kl|in|witness>
ETCD_DATA_DIR=/etcd-data
ETCD_LISTEN_PEER_URLS=https://<THIS_WG_IP>:2380
ETCD_LISTEN_CLIENT_URLS=https://<THIS_WG_IP>:2379,https://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://<THIS_WG_IP>:2380
ETCD_ADVERTISE_CLIENT_URLS=https://<THIS_WG_IP>:2379
ETCD_INITIAL_CLUSTER=kl=https://<KL_WG_IP>:2380,in=https://<IN_WG_IP>:2380,witness=https://<WITNESS_WG_IP>:2380
# TLS with a PRIVATE CA held only on the three boxes (security review B2): `etcdctl auth` covers
# the client port only; without peer cert auth anything reaching 2380 can speak raft to a member.
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/pki/ca.crt
ETCD_PEER_CERT_FILE=/etc/etcd/pki/peer.crt
ETCD_PEER_KEY_FILE=/etc/etcd/pki/peer.key
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE=/etc/etcd/pki/ca.crt
ETCD_CERT_FILE=/etc/etcd/pki/server.crt
ETCD_KEY_FILE=/etc/etcd/pki/server.key
# etcdctl inside the container (ha-checks.sh) uses the same CA and a client cert:
ETCDCTL_CACERT=/etc/etcd/pki/ca.crt
ETCDCTL_CERT=/etc/etcd/pki/healthcheck.crt
ETCDCTL_KEY=/etc/etcd/pki/healthcheck.key
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=sorento-crm-etcd
# WAN timings: links up to about 250 ms RTT (plan section 3).
ETCD_HEARTBEAT_INTERVAL=300
ETCD_ELECTION_TIMEOUT=3000
ETCD_AUTO_COMPACTION_RETENTION=1
# Never publish 2379/2380 on a public interface; firewall both to the two peer tunnel addresses
# arriving on wg0 (plus templates/host/docker-user.nft against local containers).
#
# Auth ORDER: enable it BEFORE Patroni first starts, so the leader key is never written to an
# open cluster. ha-checks.sh alerts while `etcdctl auth status` says false.
#   etcdctl user add root            (password typed in, kept in the owner's password manager,
#                                     never in any env file)
#   etcdctl user add patroni && etcdctl role add patroni
#   etcdctl role grant-permission patroni --prefix=true readwrite /sorento/
#   etcdctl user grant-role patroni patroni
#   etcdctl user add healthcheck     (NO role: `endpoint health` and `auth status` need none)
#   etcdctl auth enable
# ha-checks.sh uses only the role-less healthcheck user:
ETCDCTL_USER=healthcheck:<HEALTHCHECK_PASSWORD>
#
# Replacing a dead member: `etcdctl member remove <id>`, `etcdctl member add <name>
# --peer-urls=...`, then start the new one with ETCD_INITIAL_CLUSTER_STATE=existing.
