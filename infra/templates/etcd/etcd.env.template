# etcd member env, one per member (kl, in, witness). Plan section 2: three voters, three locations.
# Run the official etcd image (pin the version) with these as env; data dir on a volume.
ETCD_NAME=<kl|in|witness>
ETCD_DATA_DIR=/etcd-data
ETCD_LISTEN_PEER_URLS=http://<THIS_WG_IP>:2380
ETCD_LISTEN_CLIENT_URLS=http://<THIS_WG_IP>:2379,http://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://<THIS_WG_IP>:2380
ETCD_ADVERTISE_CLIENT_URLS=http://<THIS_WG_IP>:2379
ETCD_INITIAL_CLUSTER=kl=http://<KL_WG_IP>:2380,in=http://<IN_WG_IP>:2380,witness=http://<WITNESS_WG_IP>:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=sorento-crm-etcd
# WAN timings: links up to about 250 ms RTT (plan section 3).
ETCD_HEARTBEAT_INTERVAL=300
ETCD_ELECTION_TIMEOUT=3000
ETCD_AUTO_COMPACTION_RETENTION=1
# Traffic is plain http INSIDE WireGuard only; never publish 2379/2380 on a public interface.
