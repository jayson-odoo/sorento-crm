# Container firewall for the witness only: the shared-service box, whose app containers (Claude
# connector, ideation, its backend) must not reach the etcd / Patroni control plane.
# Security review B1: binding to 127.0.0.1 + the tunnel address does not keep containers out.
# A container can open <WITNESS_WG_IP>:2379/2380 through its bridge gateway, and traffic to a
# member address is masqueraded to the witness address, so a CRM node would see it as the
# witness. These rules drop it.
#
# Load with `nft -f docker-user.nft` from a systemd unit ordered After=docker.service (Docker
# rebuilds its own chains on restart; this table is separate and survives that). Then run the
# check in plan section 12, drill 9, from INSIDE an app container.
#
# <APP_SUBNETS>: every docker network the app containers join (pin them with compose `ipam`).
# IPv4 only: keep Docker IPv6 off on those networks (or add the same rules for ip6).

# Re-runnable: drop the old table first so a reload never duplicates rules.
table inet sorento_ha_guard
delete table inet sorento_ha_guard

include "/etc/sorento-ha/ha-members.nft"

table inet sorento_ha_guard {
  set app_nets { type ipv4_addr; flags interval; elements = { <APP_SUBNETS> } }
  set ha_peers { type ipv4_addr; elements = { $A_WG_IP, $B_WG_IP, $WITNESS_WG_IP } }

  # Container traffic to the host itself (published ports, host-network etcd).
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr @app_nets tcp dport { 2379, 2380, 5432, 8008 } drop
    ip saddr @app_nets ip daddr @ha_peers drop
  }

  # Container traffic routed to the other members over wg0 (before Docker's masquerade).
  chain forward {
    type filter hook forward priority -10; policy accept;
    ip saddr @app_nets ip daddr @ha_peers drop
  }

  # Published ports are DNAT'd in prerouting, so also match the original destination.
  chain prerouting_guard {
    type filter hook prerouting priority -110; policy accept;
    ip saddr @app_nets ip daddr @ha_peers drop
    ip saddr @app_nets tcp dport { 2379, 2380, 5432, 8008 } drop
  }
}
