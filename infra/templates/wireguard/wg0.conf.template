# Two-member WireGuard link between node A (CRM box) and node B (KVM 8), if a tailnet is not used.
# One file per node, listing the other as its peer. Keys generated on each box, never committed.
[Interface]
Address = <THIS_NODE_WG_IP>/32
ListenPort = 51820
PrivateKey = <THIS_NODE_PRIVATE_KEY>

[Peer]
PublicKey = <PEER_PUBLIC_KEY>
Endpoint = <PEER_PUBLIC_ADDRESS>:51820
AllowedIPs = <PEER_WG_IP>/32
PersistentKeepalive = 25

# Host firewall: 51820/udp from the peer only. Over wg0: Postgres 5432 (replication, rewind,
# the controller's role reads) and SSH 22 (deploy, config hash check).
