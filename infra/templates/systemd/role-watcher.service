# /etc/systemd/system/role-watcher.service on BOTH CRM nodes. Plan section 2 "role watcher".
[Unit]
Description=Sorento CRM role watcher (workers + scheduler only on the Patroni leader)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/sorento-crm2
Environment="COMPOSE_FILES=-f docker-compose.yml -f compose.ha.yml"
# Must match DEPLOY_LOCK_PATH of scripts/blue_green_deploy.sh (same default).
Environment=DEPLOY_LOCK_PATH=/opt/sorento-crm2/.deploy.lock
ExecStart=/opt/sorento-crm2/infra/scripts/role-watcher.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
