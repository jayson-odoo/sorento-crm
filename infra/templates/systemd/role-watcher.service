# /etc/systemd/system/role-watcher.service on BOTH CRM nodes (HA-CF-FAILOVER, plan section 2 row 5).
[Unit]
Description=Sorento CRM role watcher (workers + scheduler only where the local Postgres is primary)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=/opt/sorento-crm2
# ha-pg.sh (ROLE_CMD default) reads its settings from here.
EnvironmentFile=/etc/sorento-ha/ha-pg.env
Environment="COMPOSE_FILES=-f docker-compose.yml -f compose.ha.yml"
# Must match DEPLOY_LOCK_PATH of scripts/blue_green_deploy.sh (same default).
Environment=DEPLOY_LOCK_PATH=/opt/sorento-crm2/.deploy.lock
ExecStart=/opt/sorento-crm2/infra/scripts/role-watcher.sh
Restart=always
# Exit 3 = disarmed (ARMED flag not "yes" in ha-pg.env): stay down instead of restart-looping.
RestartPreventExitStatus=3
RestartSec=5

[Install]
WantedBy=multi-user.target
