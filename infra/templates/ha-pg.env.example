# /etc/sorento-ha/ha-pg.env on each CRM node (HA-CF-FAILOVER), mode 600, root-owned.
# Read by infra/scripts/cf_failover.py, infra/scripts/ha-pg.sh and the role watcher.
# Names and placeholders only; per-node lines are marked. No passwords here: the replication
# password sits in PGPASSFILE (mode 600) and the Cloudflare token in CF_API_TOKEN_FILE.

NODE_NAME=crm-a                      # per node: crm-a | crm-b
PEER_NAME=crm-b                      # per node
PEER_HOST=<PEER_WG_IP>               # per node
PEER_PORT=5432
REPL_USER=replicator
PGPASSFILE=/etc/sorento-ha/pgpass    # host psql (PEER_PSQL); the container reads its mounted copy
PGDATA=/var/lib/postgresql/data/pgdata

PROJECT_DIR=/opt/sorento-crm2
PG_EXEC=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml exec -T -u postgres db
PG_RUNNING=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml ps --status running -q db | grep -q .
PG_START=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml start db
PG_STOP=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml stop -t 10 db
PG_OFFLINE_SH=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml run --rm --no-deps -T -u postgres --entrypoint sh db -c
PEER_PSQL=psql
WORKERS_STOP=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml --profile promoted stop -t 5 worker worker_fast

# Cloudflare Load Balancing (token: Account, Load Balancing: Read, this account only).
CF_ACCOUNT_ID=<CF_ACCOUNT_ID>
CF_POOL_SELF=<POOL_ID_OF_THIS_NODE>  # per node
CF_POOL_PEER=<POOL_ID_OF_THE_PEER>   # per node
CF_API_TOKEN_FILE=/etc/sorento-ha/cf-token

# Timings (owner Q1: 60 s checks, 2 failures; every window derives from these two).
CF_CHECK_INTERVAL=60
CF_CONSECUTIVE_DOWN=2
APP_SICK_AFTER=900                   # owner Q3; active-passive only: REMOVE it in active-active (refused there)
SYNC_MODE=off                        # owner Q5: remote_write once the A-B RTT is measured < 2 ms

STATE_FILE=/var/lib/sorento-ha/cf-failover.json
WATCHDOG_DEVICE=/dev/watchdog
# Alerts: the text arrives on stdin. The ping URL lives in a root-only curl config file
# (`url = "<HC_FAILOVER_URL>/fail"`, mode 600), so it never shows in `ps`.
ALERT_CMD=curl -fsS -m 10 --retry 3 --data-binary @- -K /etc/sorento-ha/alert.curl

# ---- Active-active app tier (owner 4 Nov; compose.aa.yml). Leave unset for active-passive.
ACTIVE_ACTIVE=1                      # turns rule R1 on and the app-sick failover (P2) off
CF_ORIGIN_SELF=<THIS_NODE_ORIGIN_ADDRESS>   # per node: this node's origin in the ONE shared pool
CF_ORIGIN_PEER=<PEER_ORIGIN_ADDRESS>        # per node
CF_POOL_SELF=<SHARED_POOL_ID>        # the same pool id on both nodes
# CF_POOL_PEER: delete the active-passive line (the old per-node pool is gone; refused if it differs)
ROUTE_FILE=/opt/sorento-crm2/ha/route/route.ini
PGB_LOCAL_HOST=db
# RELOAD alone keeps idle server connections to the OLD primary (they hang on a dead host);
# RECONNECT closes them. The admin user is in pgbouncer's admin_users; its password comes from a
# pgpass file mounted into the pgbouncer container (mode 600), never from this file or argv.
PGB_RELOAD=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml -f /opt/sorento-crm2/compose.aa.yml exec -T -e PGPASSFILE=/etc/pgbouncer/admin.pgpass pgbouncer psql -h 127.0.0.1 -p 6432 -U <PGBOUNCER_ADMIN> pgbouncer -c RELOAD -c RECONNECT
# redis-cli authenticates with REDISCLI_AUTH, set inside the redis container (compose.aa.yml);
# the password is never on a command line or in this file.
REDIS_CLI=docker compose --project-directory /opt/sorento-crm2 -f /opt/sorento-crm2/docker-compose.yml -f /opt/sorento-crm2/compose.ha.yml -f /opt/sorento-crm2/compose.aa.yml exec -T redis redis-cli --user admin
PEER_REDIS_PORT=6379
