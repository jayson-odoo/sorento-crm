  "CompleteRequest": {
    "additionalProperties": false,
    "description": "`POST /api/v1/external/chat/turn/{turn_id}/complete` body (AC-201).\n\nThe `sub-output` trigger contract, unchanged: `item` plus the eleven nullable\nproducer outputs the sub's RS-9 carrier stubs re-emit today. Each value is a\nproducer's WHOLE output, verbatim, because the tail's by-name reads dig into it\n(`result.result.xd.block`, `answer.outcome_fragment['central-exchange']`) and\nreshaping it here would move the very bytes the replay corpus grades.\n\n`ctx` is optional: `/turn` already persisted it on the row, which is where the tail\nreads it from. Accepting it anyway means the n8n node can keep sending exactly what\nit sends today - a caller that has to DELETE a field to be accepted is a caller that\nbreaks on the next deploy.",
    "properties": {
      "access_choice": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Access Choice"
      },
      "answer": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Answer"
      },
      "clarify": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Clarify"
      },
      "crossdomain_render": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Crossdomain Render"
      },
      "ctx": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ctx"
      },
      "gate": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Gate"
      },
      "incoming_picker": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incoming Picker"
      },
      "item": {
        "additionalProperties": true,
        "title": "Item",
        "type": "object"
      },
      "not_found": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Not Found"
      },
      "offer_hold": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Offer Hold"
      },
      "resolved": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Resolved"
      },
      "result": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "suggest_offer": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Suggest Offer"
      }
    },
    "required": [
