      },
      "duplicate": {
        "default": false,
        "title": "Duplicate",
        "type": "boolean"
      },
      "is_test": {
        "default": false,
        "title": "Is Test",
        "type": "boolean"
      },
      "item": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Item"
      },
      "reply": {
