            "reply_not_contains": ["*stock* for"],
            "reply_contains_any": [
              "Customer: all",
              "sales order or delivery order",
              "Which outstanding"
            ]
          }
        }
      ]
    },
    {
      "name": "total-outstanding-cb2805a-same-phrasing-family",
      "cold": true,
      "turns": [
        {
          "text": "Total outstanding cb2805a",
          "expect": {
            "reply_not_contains": ["*stock* for"],
            "reply_contains_any": [
