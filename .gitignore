# Node modules
sorento_crm_frontend/node_modules/*
sorento_crm_backend/node_modules/*

# Next.js build output and cache
sorento_crm_frontend/.next/*
sorento_crm_backend/.next/*

# Local MCP server config (carries Bearer tokens / secrets — never commit)
.mcp.json

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Playwright MCP scratch (console logs, page snapshots)
.playwright-mcp/

# Claude-managed dev server logs
.devlogs/

# Lavish review artifacts (regenerated from the plan docs)
.lavish/

# Agent browser-verification evidence (screenshots, snapshots)
.evidence/

# OS files
.DS_Store

# Compressed files
*.gz
*.old
*.pack
*.pyc
*.pyo
__pycache__/

docker-compose.yml
/*.png

# Private keys (security audit 2026-06-29 — never commit)
*.pem
private_key.pem

# lavish artifact output (local only)
.lavish/

# Session resume documents written by /handoff. Transit, not artifacts - they must
# never land in a feature PR diff. The README documents the convention and stays.
.claude/handoffs/*
!.claude/handoffs/README.md

# Claude Code runtime state. scheduled_tasks.lock is a per-process lock
# ({sessionId, pid, acquiredAt}) rewritten by every session, so it shows as
# modified in every checkout; settings.local.json is per-machine permission
# overrides. Neither is project config - .claude/settings.json, skills/,
# agents/, commands/ stay tracked.
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Pre-trial snapshot written by scripts/container_status_trial.py - holds live
# clearance data, and is per-environment. Keep it on the box, out of the repo.
sorento_crm_backend/scripts/container_status_trial_snapshot.json

# Session handoff artifacts are machine-local, never shipped
/HANDOFF-*.md

# Repo-root node caches and e2e stack scratch
/node_modules/
.e2e-stack/
