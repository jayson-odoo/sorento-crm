      "static/chunks/app/(protected)/procurement-management/stock-inquiries/page.js"
    ],
    "/(protected)/procurement-management/stock-inquiries/[id]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(protected)/procurement-management/stock-inquiries/[id]/page.js"
    ],
    "/(protected)/procurement-management/stock-inquiries/[id]/edit/page": [
      "static/chunks/webpack.js",
