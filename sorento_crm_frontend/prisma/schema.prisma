generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// User Module
enum UserStatus {
  INACTIVE
  ACTIVE
  BLOCKED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String?
  country         String?
  timezone        String?
  name            String?
  status          UserStatus @default(INACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  lastSignInAt    DateTime?  @map("last_sign_in_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  isTrashed       Boolean    @default(false) @map("is_trashed")
  avatar          String?
  invitedByUserId String?    @map("invited_by_user_id")
  isProtected     Boolean    @default(false) @map("is_protected")
  respondUserId   String?    @map("respond_user_id")
  respondSynced   String     @default("pending") @map("respond_synced")
  superiorId      String?    @map("superior_id")

  roleAssignments UserRoleAssignment[]
  systemLog       SystemLog[]
  accounts        Account[]
  Session         Session[]
  superior        User?       @relation("UserSuperior", fields: [superiorId], references: [id])
  subordinates    User[]      @relation("UserSuperior")
  agentAccesses   UserAgentAccess[]

  @@index([invitedByUserId], map: "users_invited_by_user_id_idx")
  @@index([status], map: "users_status_idx")
  @@index([respondSynced], map: "users_respond_synced_idx")
  @@map("users")
}

model UserRole {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String   @unique
  description     String?
  isTrashed       Boolean  @default(false) @map("is_trashed")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  isProtected     Boolean  @default(false) @map("is_protected")
  isDefault       Boolean  @default(false) @map("is_default")

  userAssignments UserRoleAssignment[]
  permissions     UserRolePermission[]

  @@map("user_roles")
}

model UserRoleAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uq_user_role_assignments_user_id_role_id")
  @@index([userId], map: "ix_user_role_assignments_user_id")
  @@index([roleId], map: "ix_user_role_assignments_role_id")
  @@map("user_role_assignments")
}

model UserPermission {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  roles UserRolePermission[]

  @@map("user_permissions")
}

model UserRolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "user_role_permissions_role_id_permission_id_key")
  @@map("user_role_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_provider_account_id")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token], map: "verification_tokens_identifier_token_key")
  @@map("verification_tokens")
}

model SystemLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  entityId    String?  @map("entity_id")
  entityType  String?  @map("entity_type")
  event       String?
  description String?
  ipAddress   String?  @map("ip_address")
  meta        String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "system_logs_user_id_idx")
  @@map("system_logs")
}

model SystemSetting {
  id             String  @id @default(uuid())
  name           String  @default("My Company")
  logo           String?
  active         Boolean @default(true)
  address        String?
  websiteURL     String? @map("website_url")
  supportEmail   String? @map("support_email")
  supportPhone   String? @map("support_phone")
  language       String  @default("en")
  timezone       String  @default("UTC")
  currency       String  @default("USD")
  currencyFormat String  @default("$ {value}") @map("currency_format")

  defaultProductSupplierId           String? @map("default_product_supplier_id")
  defaultProductStandardLeadTimeDays Int     @default(90) @map("default_product_standard_lead_time_days")

  socialFacebook  String? @map("social_facebook")
  socialTwitter   String? @map("social_twitter")
  socialInstagram String? @map("social_instagram")
  socialLinkedIn  String? @map("social_linkedin")
  socialPinterest String? @map("social_pinterest")
  socialYoutube   String? @map("social_youtube")

  notifyStockEmail               Boolean  @default(true) @map("notify_stock_email")
  notifyStockWeb                 Boolean  @default(true) @map("notify_stock_web")
  notifyStockThreshold           Int      @default(10) @map("notify_stock_threshold")
  notifyStockRoleIds             String[] @map("notify_stock_role_ids")
  notifyNewOrderEmail            Boolean  @default(true) @map("notify_new_order_email")
  notifyNewOrderWeb              Boolean  @default(true) @map("notify_new_order_web")
  notifyNewOrderRoleIds          String[] @map("notify_new_order_role_ids")
  notifyOrderStatusUpdateEmail   Boolean  @default(true) @map("notify_order_status_update_email")
  notifyOrderStatusUpdateWeb     Boolean  @default(true) @map("notify_order_status_update_web")
  notifyOrderStatusUpdateRoleIds String[] @map("notify_order_status_update_role_ids")
  notifyPaymentFailureEmail      Boolean  @default(true) @map("notify_payment_failure_email")
  notifyPaymentFailureWeb        Boolean  @default(true) @map("notify_payment_failure_web")
  notifyPaymentFailureRoleIds    String[] @map("notify_payment_failure_role_ids")
  notifySystemErrorFailureEmail  Boolean  @default(true) @map("notify_system_error_failure_email")
  notifySystemErrorWeb           Boolean  @default(true) @map("notify_system_error_web")
  notifySystemErrorRoleIds       String[] @map("notify_system_error_role_ids")

  @@map("system_settings")
}

// ============================================
// Product Management - Products
// ============================================

model ProductCategory {
  id               String   @id @default(uuid())
  categoryCode     String   @unique @map("category_code") @db.VarChar(50)
  categoryName     String   @map("category_name") @db.VarChar(150)
  description      String?  @db.Text
  parentCategoryId String?  @map("parent_category_id")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int?     @default(0) @map("display_order")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("product_categories")
}

model Brand {
  id           String   @id @default(uuid())
  brandCode    String   @unique @map("brand_code") @db.VarChar(50)
  brandName    String   @map("brand_name") @db.VarChar(150)
  manufacturer String?  @db.VarChar(150)
  website      String?  @db.VarChar(255)
  description  String?  @db.Text
  logoUrl      String?  @map("logo_url") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  uomCode          String   @unique @map("uom_code") @db.VarChar(50)
  uomName          String   @map("uom_name") @db.VarChar(150)
  baseUomId        String?  @map("base_uom_id")
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(10, 4)
  description      String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  baseUom              UnitOfMeasure?         @relation("UOMHierarchy", fields: [baseUomId], references: [id], onDelete: SetNull)
  alternateUoms        UnitOfMeasure[]       @relation("UOMHierarchy")
  products             Product[]              @relation("BaseUOM")
  inboundShipmentLines InboundShipmentLine[]  @relation("InboundShipmentLineUOM")
  spoAllocations       SPOAllocation[]        @relation("SPOAllocationUOM")
  pickingLines         PickingLine[]          @relation("PickingLineUOM")

  @@index([baseUomId])
  @@map("units_of_measure")
}

model Product {
  id                String    @id @default(uuid())
  productCode       String    @unique @map("product_code") @db.VarChar(100)
  productName       String    @map("product_name") @db.VarChar(255)
  description       String?   @db.Text
  categoryId        String    @map("category_id")
  brandId           String?   @map("brand_id")
  baseUomId         String    @map("base_uom_id")
  itemType          String?   @map("item_type") @db.VarChar(50)
  listPrice         Decimal   @map("list_price") @db.Decimal(12, 2)
  costPrice         Decimal?  @map("cost_price") @db.Decimal(12, 2)
  invoicePrice      Decimal?  @map("invoice_price") @db.Decimal(12, 2)
  weight            Decimal?  @db.Decimal(10, 3)
  dimensionsLength  Decimal?  @map("dimensions_length") @db.Decimal(10, 2)
  dimensionsWidth   Decimal?  @map("dimensions_width") @db.Decimal(10, 2)
  dimensionsHeight  Decimal?  @map("dimensions_height") @db.Decimal(10, 2)
  warrantyMonths    Int?      @map("warranty_months")
  hasSerialTracking Boolean   @default(false) @map("has_serial_tracking")
  hasBatchTracking  Boolean   @default(false) @map("has_batch_tracking")
  reorderLevel      Int?      @map("reorder_level")
  reorderQuantity   Int?      @map("reorder_quantity")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  category          ProductCategory    @relation(fields: [categoryId], references: [id])
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom           UnitOfMeasure      @relation("BaseUOM", fields: [baseUomId], references: [id])
  productSuppliers     ProductSupplier[]
  stock                Stock[]
  stockBatches          StockBatch[]
  promotionProducts     PromotionProduct[]
  inboundShipmentLines InboundShipmentLine[]
  spoAllocations        SPOAllocation[]
  pickingLines          PickingLine[]

  @@index([categoryId])
  @@index([brandId])
  @@index([baseUomId])
  @@index([isActive])
  @@index([productCode])
  @@map("products")
}

// ============================================
// Procurement
// ============================================

model Supplier {
  id               String   @id @default(uuid())
  supplierCode     String   @unique @map("supplier_code") @db.VarChar(50)
  supplierName     String   @map("supplier_name") @db.VarChar(255)
  contactName      String?  @map("contact_name") @db.VarChar(150)
  email            String?  @db.VarChar(150)
  phoneNumber      String?  @map("phone_number") @db.VarChar(50)
  website          String?  @db.VarChar(255)
  addressLine1     String?  @map("address_line1") @db.VarChar(255)
  addressLine2     String?  @map("address_line2") @db.VarChar(255)
  city             String?  @db.VarChar(100)
  state            String?  @db.VarChar(100)
  postalCode       String?  @map("postal_code") @db.VarChar(20)
  country          String?  @db.VarChar(100)
  paymentTermsDays Int?     @default(30) @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  productSuppliers ProductSupplier[]
  inboundShipments InboundShipment[]

  @@index([isActive])
  @@index([country])
  @@index([city])
  @@map("suppliers")
}

model ProductSupplier {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  supplierId       String    @map("supplier_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ============================================
// Inventory Management
// ============================================

model Warehouse {
  id            String   @id @default(uuid())
  warehouseCode String   @unique @map("warehouse_code") @db.VarChar(50)
  warehouseName String   @map("warehouse_name") @db.VarChar(150)
  location      String?  @db.VarChar(255)
  managerId     String?  @map("manager_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  storageZones        StorageZone[]
  stock               Stock[]
  stockBatches        StockBatch[]
  spoAllocations      SPOAllocation[]
  sourcePickingLines  PickingLine[]         @relation("SourceWarehouse")
  destinationPickingLines PickingLine[]      @relation("DestinationWarehouse")

  @@index([isActive])
  @@index([managerId])
  @@map("warehouses")
}

model StorageZone {
  id           String   @id @default(uuid())
  warehouseId  String   @map("warehouse_id")
  zoneCode     String   @map("zone_code") @db.VarChar(50)
  zoneName     String?  @map("zone_name") @db.VarChar(150)
  zoneType     String   @map("zone_type") @db.VarChar(100) // shelf, rack, bin, pallet
  capacity     Int?     @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  spoAllocations SPOAllocation[]

  @@unique([warehouseId, zoneCode])
  @@index([warehouseId])
  @@index([zoneType])
  @@map("storage_zones")
}

model Stock {
  id                  String    @id @default(uuid())
  productId           String    @map("product_id")
  warehouseId         String    @map("warehouse_id")
  zoneId              String?   @map("zone_id")
  quantityOnHand      Int       @default(0) @map("quantity_on_hand")
  quantityReserved    Int       @default(0) @map("quantity_reserved")
  quantityAvailable   Int       @default(0) @map("quantity_available")
  quantityDamaged     Int       @default(0) @map("quantity_damaged")
  reorderPoint        Int?      @map("reorder_point")
  lastCountDate       DateTime? @map("last_count_date")
  syncedToExcel       Boolean   @default(false) @map("synced_to_excel")
  lastSyncedToExcel   DateTime? @map("last_synced_to_excel")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime? @map("updated_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  EXPIRED
  RETURNED
}

model StockBatch {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  warehouseId      String      @map("warehouse_id")
  batchCode        String      @unique @map("batch_code") @db.VarChar(100)
  quantity         Int         @default(0)
  manufacturedDate DateTime?   @map("manufactured_date")
  expiryDate       DateTime?   @map("expiry_date")
  receivedDate     DateTime    @map("received_date")
  status           BatchStatus @default(AVAILABLE)
  createdAt        DateTime    @default(now()) @map("created_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@index([expiryDate])
  @@map("stock_batches")
}

// ============================================
// Marketing Management
// ============================================

model Promotion {
  id          String        @id @default(uuid())
  promoCode   String        @unique @map("promo_code") @db.VarChar(50)
  name        String        @db.VarChar(255)
  promoType   String        @map("promo_type") @db.VarChar(50)
  description String?       @db.Text
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  isActive    Boolean       @default(true) @map("is_active")
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  promotionProducts PromotionProduct[]

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([promoType])
  @@map("promotions")
}

model PromotionProduct {
  id              String    @id @default(uuid())
  promotionId     String    @map("promotion_id")
  productId       String    @map("product_id")
  promotionPrice  Decimal?  @map("promo_selling_price") @db.Decimal(12, 2)
  discountAmount  Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
  @@map("promotion_products")
}

model CampaignType {
  id          String   @id @default(uuid())
  typeCode    String   @unique @default(uuid()) @map("type_code") @db.VarChar(50)
  typeName    String   @map("type_name") @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  campaigns MarketingCampaign[]

  @@map("campaign_types")
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model MarketingCampaign {
  id             String         @id @default(uuid())
  campaignCode   String         @unique @map("campaign_code") @db.VarChar(50)
  campaignName   String         @map("campaign_name") @db.VarChar(255)
  campaignTypeId String         @map("campaign_type_id")
  description    String?        @db.Text
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  budget         Decimal?       @db.Decimal(15, 2)
  targetAudience String?        @map("target_audience") @db.Text
  status         CampaignStatus @default(PLANNING)
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  campaignType CampaignType @relation(fields: [campaignTypeId], references: [id])

  @@index([campaignTypeId])
  @@index([status])
  @@index([startDate])
  @@map("marketing_campaigns")
}

// ============================================
// Forms Management
// ============================================

model Form {
  id           String    @id @default(uuid())
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(255)
  purpose      String?   @db.Text
  language     String    @default("en") @db.VarChar(10)
  version      Int       @default(1)
  isActive     Boolean   @default(false) @map("is_active")
  attachmentId String?   @map("attachment_id")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sections FormSection[]
  versions FormVersion[]

  @@index([isActive])
  @@index([language])
  @@map("forms")
}

model FormSection {
  id           String   @id @default(uuid())
  formId       String   @map("form_id")
  sectionName  String   @map("section_name") @db.VarChar(255)
  sectionOrder Int      @default(0) @map("section_order")
  createdAt    DateTime @default(now()) @map("created_at")

  form   Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@index([formId])
  @@index([sectionOrder])
  @@map("form_sections")
}

model FormField {
  id               String   @id @default(uuid())
  sectionId        String   @map("section_id")
  fieldName        String   @map("field_name") @db.VarChar(100)
  fieldLabel       String   @map("field_label") @db.VarChar(255)
  fieldType        String   @map("field_type") @db.VarChar(50) // text, textarea, number, email, phone, date, dropdown, radio, checkbox, file, richtext, signature
  isRequired       Boolean  @default(false) @map("is_required")
  helpText         String?  @map("help_text") @db.Text
  placeholder      String?  @db.Text
  validationRule   String?  @map("validation_rule") @db.VarChar(500)
  minLength        Int?     @map("min_length")
  maxLength        Int?     @map("max_length")
  defaultValue     String?  @map("default_value") @db.Text
  conditionalLogic Json?    @map("conditional_logic") @db.JsonB
  fieldOrder       Int      @default(0) @map("field_order")
  createdAt        DateTime @default(now()) @map("created_at")

  section FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([fieldOrder])
  @@map("form_fields")
}

model FormVersion {
  id            String   @id @default(uuid())
  formId        String   @map("form_id")
  versionNumber Int      @map("version_number")
  structure     Json     @db.JsonB
  changeSummary String?  @map("change_summary") @db.Text
  isActive      Boolean  @default(false) @map("is_active")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, versionNumber])
  @@index([formId])
  @@map("form_versions")
}

// ============================================
// Resource Management
// ============================================

model AttachmentType {
  id                String   @id @default(uuid())
  typeName          String   @unique @map("type_name") @db.VarChar(100)
  description       String?  @db.Text
  allowedExtensions String   @map("allowed_extensions") @db.VarChar(255)
  maxFileSizeMb     Int      @default(10) @map("max_file_size_mb")
  createdAt         DateTime @default(now()) @map("created_at")

  attachments Attachment[]

  @@map("attachment_types")
}

model Attachment {
  id               String    @id @default(uuid())
  attachmentTypeId String?   @map("attachment_type_id")
  originalFilename String    @map("original_filename") @db.VarChar(255)
  storedFilename   String    @map("stored_filename") @db.VarChar(255)
  filePath         String    @map("file_path") @db.VarChar(500)
  fileSizeBytes    Int?      @map("file_size_bytes")
  mimeType         String?   @map("mime_type") @db.VarChar(100)
  fileHash         String?   @map("file_hash") @db.VarChar(64)
  entityType       String?   @map("entity_type") @db.VarChar(100) // product, supplier, order, complaint, marketing, etc.
  entityId         String?   @map("entity_id")
  uploadedBy       String?   @map("uploaded_by")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  attachmentType   AttachmentType? @relation(fields: [attachmentTypeId], references: [id], onDelete: SetNull)
  inboundShipments InboundShipment[]

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([isDeleted])
  @@index([fileHash])
  @@map("attachments")
}

// ============================================
// Order Management
// ============================================

model OrderStatus {
  id            String    @id @default(uuid())
  statusCode    String    @unique @map("status_code") @db.VarChar(50)
  statusName    String    @map("status_name") @db.VarChar(100)
  description   String?   @db.Text
  sequence      Int       @default(0)
  isFinalStatus Boolean   @default(false) @map("is_final_status")
  createdAt     DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@index([sequence])
  @@index([isFinalStatus])
  @@map("order_statuses")
}

model Customer {
  id           String   @id @default(uuid())
  customerCode String   @unique @map("customer_code") @db.VarChar(50)
  customerName String   @map("customer_name") @db.VarChar(255)
  email        String?  @db.VarChar(150)
  phoneNumber  String?  @map("phone_number") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  orders Order[]

  @@index([isActive])
  @@index([customerCode])
  @@map("customers")
}

model Order {
  id                    String    @id @default(uuid())
  orderNumber           String    @unique @map("order_number") @db.VarChar(100)
  orderDate             DateTime? @map("order_date")
  estimatedDeliveryDate DateTime? @map("estimated_delivery_date")
  actualDeliveryDate    DateTime? @map("actual_delivery_date")
  customerId            String?   @map("customer_id")
  orderStatusId         String?   @map("order_status_id")
  createdBy             String?   @map("created_by")
  updatedBy             String?   @map("updated_by")
  billingAddressId      String?   @map("billing_address_id")
  shippingAddressId     String?   @map("shipping_address_id")
  subtotalAmount        Decimal   @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  discountAmount        Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount             Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount           Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  remarks               String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  syncedToExcel         Boolean   @default(false) @map("synced_to_excel")
  lastSyncedToExcel     DateTime? @map("last_synced_to_excel")

  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderStatus OrderStatus? @relation(fields: [orderStatusId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([orderStatusId])
  @@index([orderDate])
  @@index([orderNumber])
  @@index([createdBy])
  @@index([deletedAt])
  @@map("orders")
}

// ============================================
// User Management - Access Control
// ============================================

model AccessAgent {
  id                String    @id @default(uuid())
  code              String    @unique @map("code") @db.Text
  name              String    @map("name") @db.Text
  description       String?   @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  syncedToExcel     Boolean   @default(false) @map("synced_to_excel")
  lastSyncedToExcel DateTime? @map("last_synced_to_excel")

  contactAccesses ContactAgentAccess[]
  userAccesses    UserAgentAccess[]

  @@index([isActive])
  @@index([code])
  @@map("access_agents")
}

model UserAgentAccess {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  agentId   String    @map("agent_id")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent AccessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([userId])
  @@index([agentId])
  @@map("user_agent_access")
}

model ContactAgentAccess {
  id                String       @id @default(uuid())
  respondContactPhone  String       @map("respond_contact_phone") @db.Text
  respondContactName   String?      @map("respond_contact_name") @db.Text
  agentId           String       @map("agent_id")
  isAllowed         Boolean      @default(true) @map("is_allowed")
  validFrom         DateTime?    @map("valid_from")
  validTo           DateTime?    @map("valid_to")
  createdAt         DateTime     @default(now()) @map("created_at")
  createdBy         String?      @map("created_by") @db.Text
  syncedToExcel     Boolean      @default(false) @map("synced_to_excel")
  lastSyncedToExcel DateTime?    @map("last_synced_to_excel")
  updatedAt         DateTime?    @map("updated_at")

  agent AccessAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([respondContactPhone, agentId])
  @@index([agentId])
  @@index([respondContactPhone])
  @@map("contact_agent_access")
}

// ============================================
// SLA Management
// ============================================

model SLAPolicy {
  id          String    @id @default(uuid())
  code        String    @unique @map("code") @db.Text
  name        String    @map("name") @db.Text
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tiers    SLAPolicyTier[]
  tracking ConversationSLATracking[]

  @@index([isActive])
  @@index([code])
  @@map("sla_policies")
}

model SLAPolicyTier {
  id            String    @id @default(uuid())
  policyId      String    @map("policy_id")
  tierLevel     Int       @map("tier_level")
  tierName      String    @map("tier_name") @db.Text
  responseHours Int       @map("response_hours")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  policy SLAPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, tierLevel])
  @@index([policyId])
  @@map("sla_policy_tiers")
}

model ConversationSLATracking {
  id                  String    @id @default(uuid())
  policyId            String    @map("policy_id")
  currentTier         Int       @map("current_tier")
  assignedTo          String?   @map("assigned_to") @db.Text
  initiatedAt         DateTime  @default(now()) @map("initiated_at")
  currentTierStartedAt DateTime @default(now()) @map("current_tier_started_at")
  dueAt               DateTime  @map("due_at")
  escalatedAt         DateTime? @map("escalated_at")
  escalationReason    String?   @map("escalation_reason") @db.Text
  isResponded         Boolean   @default(false) @map("is_responded")
  respondedAt         DateTime? @map("responded_at")
  responseTime        Decimal?  @map("response_time") @db.Decimal(10, 2)
  isResolved          Boolean   @default(false) @map("is_resolved")
  resolvedAt          DateTime? @map("resolved_at")
  resolvedBy          String?   @map("resolved_by") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  respondContactPhone String    @map("respond_contact_phone") @db.Text
  respondContactName  String?   @map("respond_contact_name") @db.Text
  syncedToExcel       Boolean   @default(false) @map("synced_to_excel")
  lastSyncedToExcel   DateTime? @map("last_synced_to_excel")
  resolutionDuration  Decimal?  @map("resolution_duration") @db.Decimal(10, 2)

  policy        SLAPolicy                    @relation(fields: [policyId], references: [id])
  eventLogs ConversationSLAEventLog[]

  @@unique([respondContactPhone])
  @@index([policyId])
  @@index([isResolved])
  @@index([assignedTo])
  @@map("conversation_sla_tracking")
}

model ConversationSLAEventLog {
  id            String    @id @default(uuid())
  slaTrackingId String    @map("sla_tracking_id")
  eventType     String    @map("event_type") @db.Text
  fromTier      Int?      @map("from_tier")
  toTier        Int?      @map("to_tier")
  eventAt       DateTime  @default(now()) @map("event_at")
  reason        String?   @map("reason") @db.Text
  assignedTo    String?   @map("assigned_to") @db.Text
  dueAt         DateTime? @map("due_at")
  responseTime  Decimal?  @map("response_time") @db.Decimal(10, 2)
  resolutionTime Decimal? @map("resolution_time") @db.Decimal(10, 2)
  reminderCount Int       @default(0) @map("reminder_count")
  lastReminderAt DateTime? @map("last_reminder_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tracking ConversationSLATracking @relation(fields: [slaTrackingId], references: [id], onDelete: Cascade)

  @@index([slaTrackingId])
  @@index([eventAt])
  @@index([eventType])
  @@map("conversation_sla_event_log")
}

// ============================================
// Complaint Management
// ============================================

model Complaint {
  id                  String   @id @default(uuid())
  deliveryOrderNumber String?  @map("delivery_order_number") @db.Text
  complaintDate       DateTime? @map("complaint_date") @db.Date
  customerType        String?   @map("customer_type") @db.Text
  customerTypeOthers  String?   @map("customer_type_others") @db.Text
  withinWarranty      String?   @map("within_warranty") @db.Text
  productType         String?   @map("product_type") @db.Text
  defectsDiscovered   String?   @map("defects_discovered") @db.Text
  complaintType       String?   @map("complaint_type") @db.Text
  defectDescription   String?   @map("defect_description") @db.Text
  productCode         String?   @map("product_code") @db.Text
  salesperson         String?   @db.Text
  customerName        String?   @map("customer_name") @db.Text
  contactPerson       String?   @map("contact_person") @db.Text
  contactNumber       String?   @map("contact_number") @db.Text
  customerAddress     String?   @map("customer_address") @db.Text
  projectTitle        String?   @map("project_title") @db.Text

  attachments ComplaintAttachment[]

  @@index([deliveryOrderNumber])
  @@index([complaintDate])
  @@index([customerName])
  @@map("complaints")
}

model ComplaintAttachment {
  id            String    @id @default(uuid())
  complaintId   String    @map("complaint_id")
  fileName      String?   @map("file_name") @db.Text
  fileUrl       String?   @map("file_url") @db.Text
  fileSizeBytes Decimal?  @map("file_size_bytes") @db.Decimal(20, 0)
  uploadedAt    DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_attachments")
}

model ComplaintCategory {
  id            String   @id @default(uuid())
  categoryCode  String   @unique @map("category_code") @db.VarChar(50)
  categoryName  String   @map("category_name") @db.VarChar(150)
  description   String?  @db.Text
  severity      String?  @db.VarChar(50)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("complaint_categories")
}

model ComplaintStatus {
  id            String   @id @default(uuid())
  statusCode    String   @unique @map("status_code") @db.VarChar(50)
  statusName    String   @map("status_name") @db.VarChar(150)
  description   String?  @db.Text
  sequence      Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("complaint_statuses")
}

// ============================================
// Procurement - Packing Lists
// ============================================

model InboundShipment {
  id                      String    @id @default(uuid())
  shipmentNumber          String    @unique @map("shipment_number") @db.VarChar(50)
  supplierId               String    @map("supplier_id")
  shipmentDate            DateTime  @map("shipment_date") @db.Date
  estimatedArrivalDate    DateTime? @map("estimated_arrival_date") @db.Date
  actualArrivalDate       DateTime? @map("actual_arrival_date") @db.Date
  billOfLadingNumber      String?   @map("bill_of_lading_number") @db.VarChar(100)
  shippingContainerNumber String?   @map("shipping_container_number") @db.VarChar(100)
  invoiceNumber           String?   @map("invoice_number") @db.VarChar(100)
  shipmentStatus          String    @default("in_transit") @map("shipment_status") @db.VarChar(50)
  totalItemsShipped       Int?            @map("total_items_shipped")
  totalCartons            Int?            @map("total_cartons")
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now()) @map("created_at")
  createdBy               String?         @map("created_by")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  attachmentId             String          @map("attachment_id")
  syncedToExcel            Boolean         @default(false) @map("synced_to_excel")
  lastSyncedToExcel       DateTime?       @map("last_synced_to_excel")

  supplier            Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  attachment          Attachment            @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  shipmentLines       InboundShipmentLine[]
  spoAllocations      SPOAllocation[]

  @@index([supplierId])
  @@index([shipmentNumber])
  @@index([shipmentStatus])
  @@map("inbound_shipments")
}

model InboundShipmentLine {
  id                  String    @id @default(uuid())
  shipmentId          String    @map("shipment_id")
  productId           String    @map("product_id")
  quantityShipped     Int       @map("quantity_shipped")
  uomId               String?   @map("uom_id")
  batchNumber         String?   @map("batch_number") @db.VarChar(100)
  serialNumberRangeFrom String? @map("serial_number_range_from") @db.VarChar(100)
  serialNumberRangeTo   String? @map("serial_number_range_to") @db.VarChar(100)
  cartonNumber        String?   @map("carton_number") @db.VarChar(50)
  cartonsCount        Int       @default(1) @map("cartons_count")
  weightPerCarton     Decimal?  @map("weight_per_carton") @db.Decimal(10, 2)
  unitCost            Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  createdAt           DateTime  @default(now()) @map("created_at")
  syncedToExcel       Boolean   @default(false) @map("synced_to_excel")
  lastSyncedToExcel   DateTime? @map("last_synced_to_excel")
  updatedAt           DateTime? @map("updated_at")

  shipment      InboundShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product       Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom           UnitOfMeasure?   @relation("InboundShipmentLineUOM", fields: [uomId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([productId])
  @@map("inbound_shipment_lines")
}

// ============================================
// Procurement - SPO Allocations
// ============================================

model SPOAllocation {
  id                    String   @id @default(uuid())
  spoNumber             String?  @map("spo_number") @db.VarChar(50)
  spoLineNumber         Int?     @map("spo_line_number")
  inboundShipmentId     String   @map("inbound_shipment_id")
  warehouseId           String   @map("warehouse_id")
  storageZoneId         String?  @map("storage_zone_id")
  allocatedQuantity     Int      @map("allocated_quantity")
  uomId                 String?  @map("uom_id")
  receiptStatus         String   @default("pending") @map("receipt_status") @db.VarChar(50)
  quantityReceived      Int            @default(0) @map("quantity_received")
  quantityRejected      Int            @default(0) @map("quantity_rejected")
  allocationNotes       String?        @map("allocation_notes") @db.Text
  createdAt             DateTime       @default(now()) @map("created_at")
  createdBy             String?        @map("created_by")
  productId             String         @map("product_id")
  syncedToExcel         Boolean        @default(false) @map("synced_to_excel")
  updatedAt             DateTime?       @map("updated_at")
  lastSyncedToExcel     DateTime?      @map("last_synced_to_excel")

  inboundShipment     InboundShipment     @relation(fields: [inboundShipmentId], references: [id], onDelete: Cascade)
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageZone         StorageZone?       @relation(fields: [storageZoneId], references: [id], onDelete: SetNull)
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom                  UnitOfMeasure?     @relation("SPOAllocationUOM", fields: [uomId], references: [id], onDelete: SetNull)
  pickingLines         PickingLine[]

  @@unique([spoNumber, spoLineNumber], map: "uk_spo_allocations_spo_number_line_number")
  @@index([inboundShipmentId])
  @@index([warehouseId])
  @@index([productId])
  @@map("spo_allocations")
}

// ============================================
// Procurement - GRN (Goods Receipt Note)
// ============================================

model PickingHeader {
  id                  String   @id @default(uuid())
  pickingNumber       String   @unique @map("picking_number") @db.VarChar(50)
  pickingType         String   @map("picking_type") @db.VarChar(50)
  sourceEntityType    String?  @map("source_entity_type") @db.VarChar(50)
  sourceEntityId      String?  @map("source_entity_id")
  pickingDate         DateTime @default(now()) @map("picking_date") @db.Date
  pickedByUserId      String?  @map("picked_by_user_id")
  inspectionStatus    String   @default("pending") @map("inspection_status") @db.VarChar(50)
  qualityRemarks      String?  @map("quality_remarks") @db.Text
  inspectedByUserId   String?  @map("inspected_by_user_id")
  inspectionDate       DateTime? @map("inspection_date")
  pickingStatus       String   @default("draft") @map("picking_status") @db.VarChar(50)
  totalItemsPicked     Int?            @map("total_items_picked")
  totalItemsDiscrepancy Int?          @map("total_items_discrepancy")
  totalCost            Decimal?         @map("total_cost") @db.Decimal(15, 2)
  notes                String?         @db.Text
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  pickingLines PickingLine[]

  @@index([pickingType])
  @@index([pickingNumber])
  @@index([pickingStatus])
  @@map("picking_headers")
}

model PickingLine {
  id                    String          @id @default(uuid())
  pickingHeaderId       String          @map("picking_header_id")
  spoAllocationId       String?         @map("spo_allocation_id")
  productId             String          @map("product_id")
  quantityExpected      Int             @map("quantity_expected")
  quantityPicked        Int             @map("quantity_picked")
  quantityDiscrepancy   Int             @map("quantity_discrepancy") // Generated column
  uomId                 String?  @map("uom_id")
  pickedCondition       String   @default("good") @map("picked_condition") @db.VarChar(50)
  conditionRemarks      String?         @map("condition_remarks") @db.Text
  batchNumberPicked     String?         @map("batch_number_picked") @db.VarChar(100)
  expiryDate            DateTime?       @map("expiry_date") @db.Date
  unitCost              Decimal?        @map("unit_cost") @db.Decimal(12, 2)
  lineTotal             Decimal?        @map("line_total") @db.Decimal(15, 2)
  createdAt             DateTime        @default(now()) @map("created_at")
  sourceWarehouseId     String?         @map("source_warehouse_id")
  destinationWarehouseId String?       @map("destination_warehouse_id")
  syncedToExcel         Boolean         @default(false) @map("synced_to_excel")
  lastSyncedToExcel     DateTime?       @map("last_synced_to_excel")
  updatedAt             DateTime?       @map("updated_at")

  pickingHeader         PickingHeader      @relation(fields: [pickingHeaderId], references: [id], onDelete: Cascade)
  spoAllocation         SPOAllocation?     @relation(fields: [spoAllocationId], references: [id], onDelete: SetNull)
  product               Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom                   UnitOfMeasure?     @relation("PickingLineUOM", fields: [uomId], references: [id], onDelete: SetNull)
  sourceWarehouse       Warehouse?         @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse  Warehouse?        @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)

  @@index([pickingHeaderId])
  @@index([productId])
  @@index([spoAllocationId])
  @@map("picking_lines")
}

// ============================================
// Procurement - Stock Inquiries
// ============================================

model StockInquiry {
  id                 String   @id @default(uuid())
  inquiryNumber      String?  @map("inquiry_number") @db.VarChar(50)
  salesperson        String?  @db.Text
  productCode        String?  @map("product_code") @db.Text
  itemDescription    String?  @map("item_description") @db.Text
  projectCustomer    String?  @map("project_customer") @db.Text
  projectName        String?  @map("project_name") @db.Text
  quantity           Decimal? @db.Decimal(15, 2)
  deliveryDate       DateTime? @map("delivery_date") @db.Date
  brand              String?  @db.Text
  additionalRemark   String?  @map("additional_remark") @db.Text
  purchasingResponse String?  @map("purchasing_response") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([productCode])
  @@index([deliveryDate])
  @@index([createdAt])
  @@map("stock_inquiries")
}
