generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Module
enum UserStatus {
  INACTIVE
  ACTIVE
  BLOCKED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String?
  country         String?
  timezone        String?
  name            String?
  roleId          String     @map("role_id")
  status          UserStatus @default(INACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  lastSignInAt    DateTime?  @map("last_sign_in_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  isTrashed       Boolean    @default(false) @map("is_trashed")
  avatar          String?
  invitedByUserId String?    @map("invited_by_user_id")
  isProtected     Boolean    @default(false) @map("is_protected")

  role      UserRole    @relation(fields: [roleId], references: [id])
  systemLog SystemLog[]
  accounts  Account[]
  Session   Session[]

  @@index([invitedByUserId], map: "users_invited_by_user_id_idx")
  @@index([roleId], map: "users_role_id_idx")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserRole {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String   @unique
  description     String?
  isTrashed       Boolean  @default(false) @map("is_trashed")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  isProtected     Boolean  @default(false) @map("is_protected")
  isDefault       Boolean  @default(false) @map("is_default")

  users       User[]
  permissions UserRolePermission[]

  @@map("user_roles")
}

model UserPermission {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  roles UserRolePermission[]

  @@map("user_permissions")
}

model UserRolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "user_role_permissions_role_id_permission_id_key")
  @@map("user_role_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_provider_account_id")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token], map: "verification_tokens_identifier_token_key")
  @@map("verification_tokens")
}

model SystemLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  entityId    String?  @map("entity_id")
  entityType  String?  @map("entity_type")
  event       String?
  description String?
  ipAddress   String?  @map("ip_address")
  meta        String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "system_logs_user_id_idx")
  @@map("system_logs")
}

model SystemSetting {
  id             String  @id @default(uuid())
  name           String  @default("My Company")
  logo           String?
  active         Boolean @default(true)
  address        String?
  websiteURL     String? @map("website_url")
  supportEmail   String? @map("support_email")
  supportPhone   String? @map("support_phone")
  language       String  @default("en")
  timezone       String  @default("UTC")
  currency       String  @default("USD")
  currencyFormat String  @default("$ {value}") @map("currency_format")

  socialFacebook  String? @map("social_facebook")
  socialTwitter   String? @map("social_twitter")
  socialInstagram String? @map("social_instagram")
  socialLinkedIn  String? @map("social_linkedin")
  socialPinterest String? @map("social_pinterest")
  socialYoutube   String? @map("social_youtube")

  notifyStockEmail               Boolean  @default(true) @map("notify_stock_email")
  notifyStockWeb                 Boolean  @default(true) @map("notify_stock_web")
  notifyStockThreshold           Int      @default(10) @map("notify_stock_threshold")
  notifyStockRoleIds             String[] @map("notify_stock_role_ids")
  notifyNewOrderEmail            Boolean  @default(true) @map("notify_new_order_email")
  notifyNewOrderWeb              Boolean  @default(true) @map("notify_new_order_web")
  notifyNewOrderRoleIds          String[] @map("notify_new_order_role_ids")
  notifyOrderStatusUpdateEmail   Boolean  @default(true) @map("notify_order_status_update_email")
  notifyOrderStatusUpdateWeb     Boolean  @default(true) @map("notify_order_status_update_web")
  notifyOrderStatusUpdateRoleIds String[] @map("notify_order_status_update_role_ids")
  notifyPaymentFailureEmail      Boolean  @default(true) @map("notify_payment_failure_email")
  notifyPaymentFailureWeb        Boolean  @default(true) @map("notify_payment_failure_web")
  notifyPaymentFailureRoleIds    String[] @map("notify_payment_failure_role_ids")
  notifySystemErrorFailureEmail  Boolean  @default(true) @map("notify_system_error_failure_email")
  notifySystemErrorWeb           Boolean  @default(true) @map("notify_system_error_web")
  notifySystemErrorRoleIds       String[] @map("notify_system_error_role_ids")

  @@map("system_settings")
}

// ============================================
// Master Data Management - Products
// ============================================

model ProductCategory {
  id               String   @id @default(uuid())
  categoryCode     String   @unique @map("category_code") @db.VarChar(50)
  categoryName     String   @map("category_name") @db.VarChar(150)
  description      String?  @db.Text
  parentCategoryId String?  @map("parent_category_id")
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int?     @default(0) @map("display_order")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentCategoryId])
  @@index([isActive])
  @@map("product_categories")
}

model Brand {
  id           String   @id @default(uuid())
  brandCode    String   @unique @map("brand_code") @db.VarChar(50)
  brandName    String   @map("brand_name") @db.VarChar(150)
  manufacturer String?  @db.VarChar(150)
  website      String?  @db.VarChar(255)
  description  String?  @db.Text
  logoUrl      String?  @map("logo_url") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  uomCode          String   @unique @map("uom_code") @db.VarChar(50)
  uomName          String   @map("uom_name") @db.VarChar(150)
  baseUomId        String?  @map("base_uom_id")
  conversionFactor Decimal? @map("conversion_factor") @db.Decimal(10, 4)
  description      String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  baseUom       UnitOfMeasure?  @relation("UOMHierarchy", fields: [baseUomId], references: [id], onDelete: SetNull)
  alternateUoms UnitOfMeasure[] @relation("UOMHierarchy")
  products      Product[]       @relation("BaseUOM")

  @@index([baseUomId])
  @@map("units_of_measure")
}

model Product {
  id                String    @id @default(uuid())
  productCode       String    @unique @map("product_code") @db.VarChar(100)
  productName       String    @map("product_name") @db.VarChar(255)
  description       String?   @db.Text
  categoryId        String    @map("category_id")
  brandId           String?   @map("brand_id")
  baseUomId         String    @map("base_uom_id")
  itemType          String?   @map("item_type") @db.VarChar(50)
  listPrice         Decimal   @map("list_price") @db.Decimal(12, 2)
  costPrice         Decimal?  @map("cost_price") @db.Decimal(12, 2)
  invoicePrice      Decimal?  @map("invoice_price") @db.Decimal(12, 2)
  weight            Decimal?  @db.Decimal(10, 3)
  dimensionsLength  Decimal?  @map("dimensions_length") @db.Decimal(10, 2)
  dimensionsWidth   Decimal?  @map("dimensions_width") @db.Decimal(10, 2)
  dimensionsHeight  Decimal?  @map("dimensions_height") @db.Decimal(10, 2)
  warrantyMonths    Int?      @map("warranty_months")
  hasSerialTracking Boolean   @default(false) @map("has_serial_tracking")
  hasBatchTracking  Boolean   @default(false) @map("has_batch_tracking")
  reorderLevel      Int       @default(10) @map("reorder_level")
  reorderQuantity   Int       @default(50) @map("reorder_quantity")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  category          ProductCategory    @relation(fields: [categoryId], references: [id])
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  baseUom           UnitOfMeasure      @relation("BaseUOM", fields: [baseUomId], references: [id])
  productSuppliers  ProductSupplier[]
  stock             Stock[]
  stockBatches      StockBatch[]
  promotionProducts PromotionProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([baseUomId])
  @@index([isActive])
  @@index([productCode])
  @@map("products")
}

// ============================================
// Procurement Management
// ============================================

model Supplier {
  id               String   @id @default(uuid())
  supplierCode     String   @unique @map("supplier_code") @db.VarChar(50)
  supplierName     String   @map("supplier_name") @db.VarChar(255)
  contactName      String?  @map("contact_name") @db.VarChar(150)
  email            String?  @db.VarChar(150)
  phoneNumber      String?  @map("phone_number") @db.VarChar(50)
  website          String?  @db.VarChar(255)
  addressLine1     String?  @map("address_line1") @db.VarChar(255)
  addressLine2     String?  @map("address_line2") @db.VarChar(255)
  city             String?  @db.VarChar(100)
  state            String?  @db.VarChar(100)
  postalCode       String?  @map("postal_code") @db.VarChar(20)
  country          String?  @db.VarChar(100)
  paymentTermsDays Int?     @default(30) @map("payment_terms_days")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  productSuppliers ProductSupplier[]

  @@index([isActive])
  @@index([country])
  @@index([city])
  @@map("suppliers")
}

model ProductSupplier {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  supplierId       String    @map("supplier_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@map("product_suppliers")
}

// ============================================
// Inventory Management
// ============================================

model Warehouse {
  id            String   @id @default(uuid())
  warehouseCode String   @unique @map("warehouse_code") @db.VarChar(50)
  warehouseName String   @map("warehouse_name") @db.VarChar(150)
  location      String?  @db.VarChar(255)
  managerId     String?  @map("manager_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  storageZones StorageZone[]
  stock        Stock[]
  stockBatches StockBatch[]

  @@index([isActive])
  @@index([managerId])
  @@map("warehouses")
}

model StorageZone {
  id           String   @id @default(uuid())
  warehouseId  String   @map("warehouse_id")
  zoneCode     String   @map("zone_code") @db.VarChar(50)
  zoneName     String?  @map("zone_name") @db.VarChar(150)
  zoneType     String   @map("zone_type") @db.VarChar(100) // shelf, rack, bin, pallet
  capacity     Int?     @default(0)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, zoneCode])
  @@index([warehouseId])
  @@index([zoneType])
  @@map("storage_zones")
}

model Stock {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  warehouseId      String   @map("warehouse_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
}

enum BatchStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  EXPIRED
  RETURNED
}

model StockBatch {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  warehouseId      String      @map("warehouse_id")
  batchCode        String      @unique @map("batch_code") @db.VarChar(100)
  quantity         Int         @default(0)
  manufacturedDate DateTime?   @map("manufactured_date")
  expiryDate       DateTime?   @map("expiry_date")
  receivedDate     DateTime    @map("received_date")
  status           BatchStatus @default(AVAILABLE)
  createdAt        DateTime    @default(now()) @map("created_at")

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
  @@index([expiryDate])
  @@map("stock_batches")
}

// ============================================
// Marketing Management
// ============================================

enum PromotionType {
  price_override
  discount_percent
  discount_amount
  bundle
  other
}

model Promotion {
  id          String        @id @default(uuid())
  promoCode   String        @unique @map("promo_code") @db.VarChar(50)
  name        String        @db.VarChar(255)
  promoType   PromotionType @map("promo_type")
  description String?       @db.Text
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  isActive    Boolean       @default(true) @map("is_active")
  createdBy   String?       @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  promotionProducts PromotionProduct[]

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@index([promoType])
  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String    @map("promotion_id")
  productId    String    @map("product_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
  @@map("promotion_products")
}

model CampaignType {
  id          String   @id @default(uuid())
  typeCode    String   @unique @map("type_code") @db.VarChar(50)
  typeName    String   @map("type_name") @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaigns MarketingCampaign[]

  @@map("campaign_types")
}

enum CampaignStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model MarketingCampaign {
  id             String         @id @default(uuid())
  campaignCode   String         @unique @map("campaign_code") @db.VarChar(50)
  campaignName   String         @map("campaign_name") @db.VarChar(255)
  campaignTypeId String         @map("campaign_type_id")
  description    String?        @db.Text
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  budget         Decimal?       @db.Decimal(15, 2)
  targetAudience String?        @map("target_audience") @db.Text
  status         CampaignStatus @default(PLANNING)
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  campaignType CampaignType @relation(fields: [campaignTypeId], references: [id])

  @@index([campaignTypeId])
  @@index([status])
  @@index([startDate])
  @@map("marketing_campaigns")
}

// ============================================
// Forms Management
// ============================================

model Form {
  id           String    @id @default(uuid())
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(255)
  purpose      String?   @db.Text
  language     String    @default("en") @db.VarChar(10)
  version      Int       @default(1)
  isActive     Boolean   @default(false) @map("is_active")
  attachmentId String?   @map("attachment_id")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sections FormSection[]
  versions FormVersion[]

  @@index([isActive])
  @@index([language])
  @@map("forms")
}

model FormSection {
  id           String   @id @default(uuid())
  formId       String   @map("form_id")
  sectionName  String   @map("section_name") @db.VarChar(255)
  sectionOrder Int      @default(0) @map("section_order")
  createdAt    DateTime @default(now()) @map("created_at")

  form   Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@index([formId])
  @@index([sectionOrder])
  @@map("form_sections")
}

model FormField {
  id               String   @id @default(uuid())
  sectionId        String   @map("section_id")
  fieldName        String   @map("field_name") @db.VarChar(100)
  fieldLabel       String   @map("field_label") @db.VarChar(255)
  fieldType        String   @map("field_type") @db.VarChar(50) // text, textarea, number, email, phone, date, dropdown, radio, checkbox, file, richtext, signature
  isRequired       Boolean  @default(false) @map("is_required")
  helpText         String?  @map("help_text") @db.Text
  placeholder      String?  @db.Text
  validationRule   String?  @map("validation_rule") @db.VarChar(500)
  minLength        Int?     @map("min_length")
  maxLength        Int?     @map("max_length")
  defaultValue     String?  @map("default_value") @db.Text
  conditionalLogic Json?    @map("conditional_logic") @db.JsonB
  fieldOrder       Int      @default(0) @map("field_order")
  createdAt        DateTime @default(now()) @map("created_at")

  section FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([fieldOrder])
  @@map("form_fields")
}

model FormVersion {
  id            String   @id @default(uuid())
  formId        String   @map("form_id")
  versionNumber Int      @map("version_number")
  structure     Json     @db.JsonB
  changeSummary String?  @map("change_summary") @db.Text
  isActive      Boolean  @default(false) @map("is_active")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, versionNumber])
  @@index([formId])
  @@map("form_versions")
}

// ============================================
// Resource Management
// ============================================

model AttachmentType {
  id                String   @id @default(uuid())
  typeName          String   @unique @map("type_name") @db.VarChar(100)
  description       String?  @db.Text
  allowedExtensions String   @map("allowed_extensions") @db.VarChar(255)
  maxFileSizeMb     Int      @default(10) @map("max_file_size_mb")
  createdAt         DateTime @default(now()) @map("created_at")

  attachments Attachment[]

  @@map("attachment_types")
}

model Attachment {
  id               String    @id @default(uuid())
  attachmentTypeId String?   @map("attachment_type_id")
  originalFilename String    @map("original_filename") @db.VarChar(255)
  storedFilename   String    @map("stored_filename") @db.VarChar(255)
  filePath         String    @map("file_path") @db.VarChar(500)
  fileSizeBytes    Int?      @map("file_size_bytes")
  mimeType         String?   @map("mime_type") @db.VarChar(100)
  fileHash         String?   @map("file_hash") @db.VarChar(64)
  entityType       String?   @map("entity_type") @db.VarChar(100) // product, supplier, order, complaint, marketing, etc.
  entityId         String?   @map("entity_id")
  uploadedBy       String?   @map("uploaded_by")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?   @map("deleted_by")

  attachmentType AttachmentType? @relation(fields: [attachmentTypeId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([uploadedBy])
  @@index([isDeleted])
  @@index([fileHash])
  @@map("attachments")
}
