# Target selection — local | staging | prod
TARGET=local

# === Backend / Frontend base URLs ===
BE_LOCAL_URL=http://localhost:8000
FE_LOCAL_URL=http://localhost:3000

BE_STAGING_URL=
FE_STAGING_URL=

# Production frontend; backend is reached via FE proxy or direct
BE_PROD_URL=
FE_PROD_URL=https://fe-sorento.foundryx.my

# === Auth ===
LOADTEST_USER_EMAIL=loadtest@sorento.local
LOADTEST_USER_PASSWORD=changeme

# Shared HS256 secret used by FE NextAuth + BE FastAPI to validate JWTs.
# Required: k6 mints its own JWT locally with this secret. The BE login route
# does NOT return a JWT — it only returns the user profile. Match the value of
# NEXTAUTH_SECRET in sorento_crm_frontend/.env (== JWT_SECRET in backend/.env).
NEXTAUTH_SECRET=
JWT_TTL_SECONDS=3600

# X-API-Key for /api/v1/external/* routes
EXTERNAL_API_KEY=

# === n8n cloned LOADTEST workflows ===
# These MUST be the cloned [LOADTEST] workflow URLs, not the production ones.
N8N_LOADTEST_STOCK_INQUIRY_REVISE_URL=
N8N_LOADTEST_ATTACHMENT_URL=
N8N_LOADTEST_CRM_CHAT_OUTBOUND_URL=

# Set to true to allow hitting automate-sorento.foundryx.my (production n8n).
# Strongly discouraged — clone the workflows first.
N8N_ALLOW_PROD_URL=

# === Output ===
# Set to influxdb=http://localhost:8086/k6 to stream into local Grafana
K6_OUT=

# === Profile defaults (override per run via -e PROFILE=...) ===
PROFILE=smoke
